<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Other fullscreen params are set here: leanback-1.0.0\src\main\res\values-v19\values-v19.xml:3 -->
    <style name="FitSystemWindows" parent="TransparentStatus">
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
    <style name="BehindSystemWindows" parent="TransparentStatus">
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>
    <style name="TransparentStatus">
        <!-- Make status and nav bars same color as the app -->
        <item name="android:windowTranslucentStatus" tools:targetApi="19">true</item>
        <item name="android:windowTranslucentNavigation" tools:targetApi="19">true</item>
    </style>

    <style name="PinPadButton">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/pin_pad_button_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>