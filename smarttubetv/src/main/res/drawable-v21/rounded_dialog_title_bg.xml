<?xml version="1.0" encoding="utf-8"?>
<!-- Title band of the floating settings dialog: rounded on top to match the panel.
     Follows the active color scheme through the theme attribute, which drawables can only
     resolve from API 21 (the base drawable keeps a solid fallback for older devices). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
    <solid android:color="?attr/defaultBrandColor" />
</shape>
